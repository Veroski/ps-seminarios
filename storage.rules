rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function hasFormationAccess(formationId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.productosComprados is list
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.productosComprados.hasAny([formationId]);
    }

    match /covers/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /formaciones/{formationId}/materiales/{allPaths=**} {
      allow read: if hasFormationAccess(formationId);
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
