{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "app.patriciasongel.es"
        }
      ],
      "destination": "/"
    },
    {
      "source": "/alumnos/formaciones/:path*",
      "destination": "/"
    },
    {
      "source": "/alumnos/gracias",
      "destination": "/"
    }
  ]
}
